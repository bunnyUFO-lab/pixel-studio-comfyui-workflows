# Credentials, kept separate from the .env presets so switching presets never touches them.
# Copy to .secrets.env (gitignored) and fill in what you need: cp .secrets.env.example .secrets.env

# Civitai API key (free account): civitai.com > Account settings > API Keys.
# Needed for models hosted on Civitai (workflows whose model URLs point to civitai.com).
CIVITAI_TOKEN=

# Hugging Face token (free account): huggingface.co/settings/tokens. Only for gated models.
HF_TOKEN=
