# Preset: video. Use with: cp env/video.env .env
# MODELS = workflows whose models are downloaded (if missing) on every start.
# wan22-remix ~36 GB; wan22-svi-extend uses the same models + 2 SVI LoRAs (2.5 GB).
MODELS=image-to-video/wan22-remix,video-to-video/wan22-svi-extend

# Optional overrides (defaults live in docker-compose.yml):
# COMFYUI_REF=v0.38.2        # ComfyUI git tag; after changing: docker compose up -d --build
# PORT=8188                  # host port
# BIND_ADDRESS=0.0.0.0       # LAN/VPN reachable (default); 127.0.0.1 = this PC only
# COMFY_ARGS=                # extra ComfyUI flags, e.g. --reserve-vram 1
