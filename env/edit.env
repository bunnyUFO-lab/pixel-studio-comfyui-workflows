# Preset: image editing. Use with: cp env/edit.env .env
# qwen-edit needs Qwen-Image-2.1 (~17.3 GB, non-commercial licence).
MODELS=image-edit/qwen-edit

# Optional overrides (defaults live in docker-compose.yml):
# COMFYUI_REF=v0.41.3        # ComfyUI git tag; after changing: docker compose up -d --build
# PORT=8188                  # host port
# BIND_ADDRESS=0.0.0.0       # LAN/VPN reachable (default); 127.0.0.1 = this PC only
# COMFY_ARGS=                # extra ComfyUI flags, e.g. --reserve-vram 1
