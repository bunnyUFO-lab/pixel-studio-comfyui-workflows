# Preset: SVG workflows. Use with: cp env/svg.env .env
# vtracer-svg / layered-svg need only the 18 MB upscaler; layered-svg-ai adds Qwen-Image-2.1 (~17.3 GB);
# prompt-to-svg adds Z-Image Turbo (~21 GB).
MODELS=image-to-svg/vtracer-svg,image-to-svg/layered-svg,image-to-svg/layered-svg-ai,image-to-svg/prompt-to-svg

# Optional overrides (defaults live in docker-compose.yml):
# COMFYUI_REF=v0.38.2        # ComfyUI git tag; after changing: docker compose up -d --build
# PORT=8188                  # host port
# BIND_ADDRESS=0.0.0.0       # LAN/VPN reachable (default); 127.0.0.1 = this PC only
# COMFY_ARGS=                # extra ComfyUI flags, e.g. --reserve-vram 1
