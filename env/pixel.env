# Preset: pixel-art workflows. Use with: cp env/pixel.env .env
# image-to-pixel 444 MB (BiRefNet); prompt-to-pixel ~21 GB (Z-Image Turbo + LoRA); sprite-from-prompt = Wan 2.2 Remix
# (~36 GB) + 2.5 GB LoRA; sprite-from-video ~18.6 GB (Wan Animate 2); sprite-from-video-scail2 +19.6 GB (SCAIL 2, SAM3.1); image-to-directions ~17.3 GB (Qwen-Image-2.1);
# sprite-inbetween (AI Animate) ~37 GB (Wan 2.2 Fun VACE HIGH + LOW fp8 + 4-step LoRAs); extract-pose 1.9 GB (SDPose).
MODELS=pixel-art/image-to-pixel,pixel-art/prompt-to-pixel,pixel-art/sprite-from-prompt,pixel-art/sprite-from-video,pixel-art/sprite-from-video-scail2,pixel-art/image-to-directions,pixel-art/sprite-edit,pixel-art/prompt-to-tile,image/prompt-to-image,image-to-video/wan22-remix,image-edit/qwen-edit,pixel-art/sprite-inbetween,pose/extract-pose

# Optional overrides (defaults live in docker-compose.yml):
# COMFYUI_REF=v0.38.2        # ComfyUI git tag; after changing: docker compose up -d --build
# PORT=8188                  # host port
# BIND_ADDRESS=0.0.0.0       # LAN/VPN reachable (default); 127.0.0.1 = this PC only
# COMFY_ARGS=                # extra ComfyUI flags, e.g. --reserve-vram 1
