# Preset: every workflow in workflows/ (~36 GB today). Use with: cp .env.all .env
# Civitai-hosted models need CIVITAI_TOKEN in .secrets.env.
MODELS=all

# Optional overrides (defaults live in docker-compose.yml):
# COMFYUI_REF=v0.38.2        # ComfyUI git tag; after changing: docker compose up -d --build
# PORT=8188                  # host port
# BIND_ADDRESS=0.0.0.0       # LAN/VPN reachable (default); 127.0.0.1 = this PC only
# COMFY_ARGS=                # extra ComfyUI flags, e.g. --reserve-vram 1

# Storage locations (defaults: folders in this repo). Keep generated files off drive C:, e.g.:
# COMFY_OUTPUT_DIR=G:/ComfyUI/output
# COMFY_INPUT_DIR=G:/ComfyUI/input
# TRAIN_DIR=G:/pixel-studio/train   # must be the app's <data>/train when training
# TRAINER_CACHE_DIR=G:/SpriteStudio/trainer/hf_cache
