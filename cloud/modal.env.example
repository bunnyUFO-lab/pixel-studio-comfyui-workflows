# Settings of the Modal deployment (cloud/modal_comfy.py). Copy to cloud/modal.env (git-ignored) and edit.
# Precedence: process environment > cloud/modal.env > these defaults. Read once, at deploy time.

# App name. Keep the default for the app other tools already use; use another name to try changes safely.
MODAL_APP=sprite-studio-comfy

# GPU type(s), comma separated: Modal tries them in order (RTX-PRO-6000 3.03 USD/h, L40S 1.95, A100-80GB 2.50, H100 3.95).
MODAL_GPU=RTX-PRO-6000,L40S

# How many job containers may run at once (1..32). Each runs one job at a time.
MODAL_MAX_CONTAINERS=3

# Seconds a warm container waits for the next job before it shuts down (you pay for the wait).
MODAL_IDLE_SECONDS=300

# Which models "download" fetches by default: pixel, starter, all, or a comma-separated list of workflows.
MODAL_PRESET=pixel

# Longest a single job may run, in seconds (at most 3600).
MODAL_JOB_TIMEOUT=3600
